# Copy to backend/.env (git-ignored) and fill in.

# AI provider: gemini (free tier available) or anthropic (Claude, paid)
MEDGUARD_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# MEDGUARD_GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=

# development | production (production requires Postgres + Redis and uses Secure cookies)
MEDGUARD_ENV=development
# Defaults to SQLite at backend/medguard.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/medguard

# Optional overrides
# MEDGUARD_CORS_ORIGINS=http://localhost:3000
# MEDGUARD_SESSION_DAYS=14
# MEDGUARD_EXTRACTIONS_PER_HOUR=20
# MEDGUARD_ROUTINES_PER_HOUR=20
